$ORIGIN testsync.accre.vu.
$TTL 300
@       IN  SOA ns1.testsync.accre.vu. admin.testsync.accre.vu. (
                    2024102101  ; serial
                    3600       ; refresh
                    900        ; retry
                    604800     ; expire
                    300 )      ; minimum
@       IN  NS  ns1.testsync.accre.vu.
@       IN  NS  ns2.testsync.accre.vu.
@       IN  A   10.0.0.1
www     IN  A   10.0.0.1
api     IN  A   10.0.0.2
mail    IN  A   10.0.0.3
; Glue for the in-zone NS targets. BIND requires these A records for the zone
; to load, so they must be present both in the BIND baseline (k8s/bind-config.
; yaml) and here -- otherwise DNSSync's full reconciliation would treat them
; as stale and delete them.
ns1     IN  A   10.0.0.10
ns2     IN  A   10.0.0.11
